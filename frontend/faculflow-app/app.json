{
  "expo": {
    "name": "Faculflow",
    "slug": "faculflow-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#00BFA5"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.faculflow.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#00BFA5"
      },
      "edgeToEdgeEnabled": false,
      "package": "com.faculflow.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "1bfd2cca-fb3e-482c-9f2c-490d62b006e9"
      }
    },
    "plugins": [
      "expo-font",
      "expo-secure-store"
    ],
    "owner": "zigifrid"
  }
}
